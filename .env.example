DATABASE_URL=postgres://brainpile:brainpile@127.0.0.1:5432/brainpile
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=brainpile-admin
S3_SECRET_KEY=brainpile-admin
S3_BUCKET=brainpile
EMBEDDING_API_URL=http://127.0.0.1:8000

# 用于生成浏览器访问的文件链接；其他设备访问时需改为可访问的地址。
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333

RUST_LOG=info

# 以上配置仅开发服务端读取，Docker部署时请在 docker-compose.yml 中编辑
# OpenAI Chat Completions 兼容接口，模型需要支持视觉
VLM_API_BASE=https://your-vlm-service.example/v1
VLM_API_KEY=your-api-key
VLM_MODEL=your-model-name

TG_BOT_TOKEN=your-telegram-bot-token


